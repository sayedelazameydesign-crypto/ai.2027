#!/usr/bin/env bash
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref##refs/heads/}"
  if [[ "$branch" == "main" ]]; then
    echo "Pre-push checks for protected-by-convention branch main"
    test -f README.md
    test -f LICENSE
    test -f CHANGELOG.md
    test -f .env.example
    test -f docs/decisions.md
    test -d src
    test -d tests
    test -d config
    test -d prompts

    if command -v pre-commit >/dev/null 2>&1; then
      pre-commit run --all-files
    fi

    if [[ -f package.json ]]; then
      npm test --if-present
      npm run lint --if-present
      npm run type-check --if-present
    elif [[ -f pyproject.toml ]]; then
      python -m compileall -q src tests
      python -m pytest -q
      python -m ruff check src tests
      python -m mypy src
    else
      echo "No language runtime configured yet; repository checks passed."
    fi
  fi
done
